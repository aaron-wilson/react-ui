# Public GraphQL endpoint; defaults to the local GraphQL service.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
# Public static-site origin used only for generated metadata.
UI_SITE_ORIGIN=http://localhost:3001
# Public mode: demo (default) or live.
NEXT_PUBLIC_APP_MODE=demo
# Public Cognito managed-login origin; required only in live mode.
NEXT_PUBLIC_COGNITO_DOMAIN=
# Public Cognito app-client ID without a client secret; required only in live mode.
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Public user-pool issuer URL; required only in live mode.
NEXT_PUBLIC_COGNITO_ISSUER=
# Public registered callback URL matching this site's origin; required only in live mode.
NEXT_PUBLIC_AUTH_REDIRECT_URI=
