# Required public deployment identifiers; never auto-loaded.
PLATFORM_ACCOUNT=111111111111
PLATFORM_REGION=us-east-1
PLATFORM_ENV=demo
PLATFORM_SITE_ORIGIN=https://wander.example
# Required existing certificate in us-east-1 for the site hostname.
UI_CERTIFICATE_ARN=arn:aws:acm:us-east-1:111111111111:certificate/00000000-0000-4000-8000-000000000000
# Required full UI Git SHA for build and publication; non-secret artifact revision.
UI_ASSET_REVISION=1111111111111111111111111111111111111111
# Required for publication; foundation bucket and UI stack distribution ID.
UI_BUCKET_NAME=example-bucket
UI_DISTRIBUTION_ID=EXAMPLE123
# Optional export folder for publication tests; default out.
STATIC_ARTIFACT_DIR=out
